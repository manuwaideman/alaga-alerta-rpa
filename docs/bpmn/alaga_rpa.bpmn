<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_AlagaRPA" targetNamespace="http://alagaalerta.example/bpmn">
  <bpmn:process id="Process_AlagaRPA" name="Alaga Alerta - Robo de monitoramento e alerta" isExecutable="false">
    <bpmn:startEvent id="Id_start" name="Agendador (a cada 30 min)"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="Id_carregar" name="Carregar config e abrir log"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Id_reenviar" name="Reenviar pendentes (Telegram e MVP)"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Id_entradas" name="Ler boletim CGE, Ouro e sensor"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Id_chuva" name="Para cada bairro: consultar chuva (Open-Meteo)"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing><bpmn:multiInstanceLoopCharacteristics isSequential="true" /></bpmn:task>
    <bpmn:exclusiveGateway id="Id_gwApi" name="API respondeu?"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Id_fallback" name="Usar cache ou registrar falha"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Id_calcular" name="Decidir risco (maior das fontes)"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="Id_gwRisco" name="Risco acima de normal?"><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Id_semAlerta" name="Registrar 'sem alerta'"><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_19</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="Id_gwDup" name="Alerta já existe?"><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Id_ignorar" name="Ignorar duplicado"><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_20</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Id_gravar" name="Gravar alerta e publicar no MVP (POST /alertas)"><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Id_disparar" name="Enviar alerta (Telegram)"><bpmn:incoming>Flow_14</bpmn:incoming><bpmn:outgoing>Flow_15</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="Id_gwEnvio" name="Envio ok?"><bpmn:incoming>Flow_15</bpmn:incoming><bpmn:outgoing>Flow_16</bpmn:outgoing><bpmn:outgoing>Flow_17</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Id_falhaEnvio" name="Marcar pendente e logar erro"><bpmn:incoming>Flow_17</bpmn:incoming><bpmn:outgoing>Flow_18</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Id_resumo" name="Gravar auditoria e resumo no log"><bpmn:incoming>Flow_16</bpmn:incoming><bpmn:incoming>Flow_18</bpmn:incoming><bpmn:incoming>Flow_19</bpmn:incoming><bpmn:incoming>Flow_20</bpmn:incoming><bpmn:outgoing>Flow_21</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="Id_end" name="Fim"><bpmn:incoming>Flow_21</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Id_start" targetRef="Id_carregar" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Id_carregar" targetRef="Id_reenviar" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Id_reenviar" targetRef="Id_entradas" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Id_entradas" targetRef="Id_chuva" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Id_chuva" targetRef="Id_gwApi" />
    <bpmn:sequenceFlow id="Flow_6" name="sim" sourceRef="Id_gwApi" targetRef="Id_calcular" />
    <bpmn:sequenceFlow id="Flow_7" name="não" sourceRef="Id_gwApi" targetRef="Id_fallback" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Id_fallback" targetRef="Id_calcular" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Id_calcular" targetRef="Id_gwRisco" />
    <bpmn:sequenceFlow id="Flow_10" name="sim" sourceRef="Id_gwRisco" targetRef="Id_gwDup" />
    <bpmn:sequenceFlow id="Flow_11" name="não" sourceRef="Id_gwRisco" targetRef="Id_semAlerta" />
    <bpmn:sequenceFlow id="Flow_12" name="não" sourceRef="Id_gwDup" targetRef="Id_gravar" />
    <bpmn:sequenceFlow id="Flow_13" name="sim" sourceRef="Id_gwDup" targetRef="Id_ignorar" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Id_gravar" targetRef="Id_disparar" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Id_disparar" targetRef="Id_gwEnvio" />
    <bpmn:sequenceFlow id="Flow_16" name="sim" sourceRef="Id_gwEnvio" targetRef="Id_resumo" />
    <bpmn:sequenceFlow id="Flow_17" name="não" sourceRef="Id_gwEnvio" targetRef="Id_falhaEnvio" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Id_falhaEnvio" targetRef="Id_resumo" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Id_semAlerta" targetRef="Id_resumo" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Id_ignorar" targetRef="Id_resumo" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Id_resumo" targetRef="Id_end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Process_AlagaRPA">
      <bpmndi:BPMNShape id="Id_start_di" bpmnElement="Id_start"><dc:Bounds x="91" y="281" width="38" height="38" /></bpmndi:BPMNShape>
