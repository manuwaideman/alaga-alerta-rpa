# Copie para .env (que está no .gitignore) e preencha: o robô lê o .env sozinho ao iniciar.
# Sem as variáveis do Telegram o canal é "simulado"; sem MVP_URL/MVP_API_KEY o robô roda só local.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Integração com a API central do MVP (deixe vazio para rodar só local)
MVP_URL=
MVP_API_KEY=
# Opcionais
LIMIAR_ATENCAO_MM=15
LIMIAR_PERIGO_MM=30
JANELA_HORAS=3
TENTATIVAS=3
ESPERA_BASE_S=1
BOLETIM_VALIDADE_H=6
